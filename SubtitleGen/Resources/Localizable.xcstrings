    "목록의 처리 상태만 초기화합니다. 영상과 자막 파일은 보존합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resets only the processing status in the list. Videos and subtitle files are kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストの処理状態のみをリセットします。動画と字幕ファイルは保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅重置列表中的处理状态。视频和字幕文件将保留。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialise uniquement l’état de traitement de la liste. Les vidéos et fichiers de sous-titres sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt nur den Verarbeitungsstatus in der Liste zurück. Video- und Untertiteldateien bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se restablece el estado de procesamiento de la lista. Los vídeos y archivos de subtítulos se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefine apenas o status de processamento da lista. Os arquivos de vídeo e legendas são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбрасывается только статус обработки в списке. Видео и файлы субтитров сохраняются."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록의 처리 상태만 초기화합니다. 영상과 자막 파일은 보존합니다."
          }
        }
      }
    },
