    "음성인식 도구의 개발자 서명을 확인하지 못했습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성인식 도구의 개발자 서명을 확인하지 못했습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't verify the developer signature of the speech recognition tool."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声認識ツールの開発者署名を確認できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证语音识别工具的开发者签名。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier la signature développeur de l’outil de reconnaissance vocale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Entwicklersignatur des Spracherkennungswerkzeugs konnte nicht überprüft werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la firma de desarrollador de la herramienta de reconocimiento de voz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a assinatura de desenvolvedor da ferramenta de reconhecimento de fala."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить подпись разработчика инструмента распознавания речи."
          }
        }
      }
    },
