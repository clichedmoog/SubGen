    "선택한 ChatGPT 계정에 다시 로그인해주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please sign in to the selected ChatGPT account again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した ChatGPT アカウントにもう一度サインインしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新登录所选的 ChatGPT 账户。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous au compte ChatGPT sélectionné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte melden Sie sich erneut beim ausgewählten ChatGPT-Account an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelva a iniciar sesión en la cuenta de ChatGPT seleccionada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie a sessão novamente na conta do ChatGPT selecionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова войдите в выбранный аккаунт ChatGPT."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 ChatGPT 계정에 다시 로그인해주세요."
          }
        }
      }
    },
    "선택한 모델 %@을 다운로드합니다. 인터넷 연결과 여유 저장 공간이 필요합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads the selected model %@. Requires an internet connection and free storage space."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したモデル %@ をダウンロードします。インターネット接続と空きストレージ容量が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将下载所选模型 %@。需要网络连接和足够的存储空间。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle sélectionné %@ va être téléchargé. Une connexion Internet et de l’espace de stockage libre sont nécessaires."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Modell %@ wird geladen. Eine Internetverbindung und freier Speicherplatz sind erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descargará el modelo seleccionado (%@). Se necesita conexión a internet y espacio de almacenamiento libre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo selecionado %@ será baixado. É necessário ter conexão com a internet e espaço livre em disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет загружена выбранная модель %@. Нужны подключение к интернету и свободное место на диске."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 모델 %@을 다운로드합니다. 인터넷 연결과 여유 저장 공간이 필요합니다."
          }
        }
      }
    },
    "선택한 모델을 사용할 수 없습니다. 모델 목록을 새로고침해주세요.": {
      "localizations": {
