    "저장된 ChatGPT 연결 정보를 읽을 수 없습니다. 키체인을 확인해주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the saved ChatGPT connection. Check your keychain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されている ChatGPT の接続情報を読み込めません。キーチェーンを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取已保存的 ChatGPT 连接信息。请检查钥匙串。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les informations de connexion ChatGPT enregistrées. Vérifiez le trousseau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte ChatGPT-Verbindungsdaten konnten nicht gelesen werden. Bitte prüfen Sie den Schlüsselbund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer la conexión con ChatGPT guardada. Revise el llavero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler os dados de conexão salvos do ChatGPT. Verifique o app Chaves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать сохранённые данные подключения ChatGPT. Проверьте связку ключей."
