    "계정 없이 이 Mac에서 번역합니다. 자막이 외부로 전송되지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translates on this Mac without an account. Subtitles never leave your device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントなしでこの Mac 上で翻訳します。字幕が外部に送信されることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户，在这台 Mac 上翻译。字幕不会发送到外部。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduit sur ce Mac, sans compte. Les sous-titres ne quittent pas l’appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzt ohne Account auf diesem Mac. Untertitel werden nicht nach außen gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce en este Mac sin cuenta. Los subtítulos no salen del equipo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduz neste Mac sem conta. As legendas não são enviadas para fora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод выполняется на этом Mac без аккаунта. Субтитры никуда не отправляются."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 없이 이 Mac에서 번역합니다. 자막이 외부로 전송되지 않습니다."
          }
        }
      }
    },
