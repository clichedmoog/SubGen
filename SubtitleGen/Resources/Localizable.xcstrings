    "%@ 설치 또는 실행 검증에 실패했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ failed to install or pass the launch check."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のインストールまたは実行の検証に失敗しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 安装或运行验证失败。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’installation ou de la vérification d’exécution de %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation oder Ausführungsprüfung von %@ fehlgeschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la instalación o ejecución de %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao instalar ou verificar a execução de %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось установить или проверить запуск %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 설치 또는 실행 검증에 실패했습니다."
          }
        }
      }
    },
    "%@ 설치 또는 실행 검증에 실패했습니다. 다시 시도해주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ failed to install or pass the launch check. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のインストールまたは実行の検証に失敗しました。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 安装或运行验证失败。请重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’installation ou de la vérification d’exécution de %@. Veuillez réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation oder Ausführungsprüfung von %@ fehlgeschlagen. Bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la instalación o ejecución de %@. Inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao instalar ou verificar a execução de %@. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось установить или проверить запуск %@. Повторите попытку."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 설치 또는 실행 검증에 실패했습니다. 다시 시도해주세요."
          }
        }
      }
    },
