    "앱에 포함된 도구를 실행하지 못했습니다. 앱을 다시 설치해주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't run the tools included in the app. Please reinstall the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリに含まれるツールを実行できませんでした。アプリを再インストールしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法运行应用内置的工具。请重新安装应用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’exécuter les outils inclus dans l’app. Veuillez réinstaller l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die in der App enthaltenen Werkzeuge konnten nicht ausgeführt werden. Bitte installieren Sie die App neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron ejecutar las herramientas incluidas en la app. Vuelva a instalar la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível executar as ferramentas incluídas no app. Reinstale o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить встроенный инструмент. Переустановите приложение."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에 포함된 도구를 실행하지 못했습니다. 앱을 다시 설치해주세요."
