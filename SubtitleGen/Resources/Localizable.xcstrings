    "%@ 언어 팩 다운로드가 끝나지 않았습니다. 시스템 설정 > 일반 > 언어 및 지역 > 번역 언어에서 확인한 뒤 다시 실행해주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ language pack hasn't finished downloading. Check System Settings > General > Language & Region > Translation Languages, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 言語パックのダウンロードが完了していません。システム設定 > 一般 > 言語と地域 > 翻訳言語 で確認してから、もう一度実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 语言包尚未下载完成。请在“系统设置 > 通用 > 语言与地区 > 翻译语言”中确认后重新运行。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement du pack de langue %@ n’est pas terminé. Vérifiez dans Réglages Système > Général > Langue et région > Langues de traduction, puis relancez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download des Sprachpakets %@ ist nicht abgeschlossen. Prüfen Sie dies unter Systemeinstellungen > Allgemein > Sprache & Region > Übersetzungssprachen und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga del paquete de idioma %@ no ha terminado. Compruébelo en Ajustes del Sistema > General > Idioma y región > Idiomas de traducción y vuelva a ejecutar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download do pacote de idioma %@ não foi concluído. Verifique em Ajustes do Sistema > Geral > Idioma e Região > Idiomas de Tradução e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка языкового пакета %@ не завершена. Проверьте его в Системные настройки > Основные > Язык и регион > Языки перевода и запустите снова."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 언어 팩 다운로드가 끝나지 않았습니다. 시스템 설정 > 일반 > 언어 및 지역 > 번역 언어에서 확인한 뒤 다시 실행해주세요."
          }
        }
      }
    },
    "%@ 언어 팩 다운로드가 허용되지 않았습니다. 다시 실행하면 다시 요청합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ language pack download wasn't allowed. Run again to be asked again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 言語パックのダウンロードが許可されませんでした。もう一度実行すると再度確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未允许下载 %@ 语言包。重新运行时将再次请求。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement du pack de langue %@ n’a pas été autorisé. Il sera redemandé au prochain lancement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download des Sprachpakets %@ wurde nicht erlaubt. Beim nächsten Start wird erneut gefragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se permitió descargar el paquete de idioma %@. Se volverá a solicitar al ejecutar de nuevo."
