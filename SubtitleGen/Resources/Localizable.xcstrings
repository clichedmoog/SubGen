    "Apple 번역 %@ 언어 팩 준비 중 · 다운로드 확인 창이 뜨면 허용해주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing the %@ language pack for Apple Translation · Allow the download if prompted"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 翻訳の %@ 言語パックを準備中 · ダウンロードの確認が表示されたら許可してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备 Apple 翻译 %@ 语言包 · 如弹出下载确认窗口，请允许"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparation du pack de langue %@ pour Apple Traduction · Autorisez le téléchargement si une fenêtre de confirmation apparaît"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-Übersetzung: Sprachpaket %@ wird vorbereitet · Bitte erlauben Sie den Download, wenn Sie gefragt werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando el paquete de idioma %@ de Apple Translation · Acepte si aparece el diálogo de descarga"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando o pacote de idioma %@ da Tradução da Apple · Permita o download se for solicitado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовка языкового пакета %@ для Apple Translation · разрешите загрузку, если появится запрос"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 번역 %@ 언어 팩 준비 중 · 다운로드 확인 창이 뜨면 허용해주세요"
          }
        }
      }
    },
