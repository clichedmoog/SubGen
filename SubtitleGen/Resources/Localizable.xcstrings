    "현재 CPU에서 실행 가능한 whisper-cli, ffmpeg, ffprobe를 설치해주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install whisper-cli, ffmpeg, and ffprobe that can run on this CPU."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の CPU で実行できる whisper-cli、ffmpeg、ffprobe をインストールしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请安装可在当前 CPU 上运行的 whisper-cli、ffmpeg、ffprobe。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez whisper-cli, ffmpeg et ffprobe compatibles avec le processeur de ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebräisch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale whisper-cli, ffmpeg y ffprobe compatibles con la CPU actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale versões de whisper-cli, ffmpeg e ffprobe compatíveis com a CPU atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите whisper-cli, ffmpeg и ffprobe, совместимые с текущим CPU."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 CPU에서 실행 가능한 whisper-cli, ffmpeg, ffprobe를 설치해주세요."
          }
        }
      }
    },
