    "자동 감지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-Detect"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動検出"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检测"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détection automatique"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch erkennen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detección automática"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecção automática"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоопределение"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 감지"
          }
        }
      }
    },
    "자동 감지된 언어의 언어 팩이 없으면 번역 직전에 다운로드를 묻고, 받은 뒤 번역합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the language pack for an auto-detected language is missing, you'll be asked to download it right before translation, and translation continues once it's downloaded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動検出した言語の言語パックがない場合は、翻訳の直前にダウンロードを確認し、ダウンロード後に翻訳します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果没有自动检测到的语言的语言包，将在翻译前询问是否下载，下载后再翻译。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le pack de langue de la langue détectée manque, son téléchargement est proposé juste avant la traduction, qui se poursuit ensuite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlt das Sprachpaket für die automatisch erkannte Sprache, wird vor der Übersetzung nach dem Download gefragt und danach übersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si falta el paquete de idioma del idioma detectado, se pedirá descargarlo justo antes de traducir y se traducirá después."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se faltar o pacote de idioma do idioma detectado, o download é solicitado antes da tradução, que começa após o download."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если для автоматически определённого языка нет языкового пакета, перед переводом будет предложено его загрузить."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 감지된 언어의 언어 팩이 없으면 번역 직전에 다운로드를 묻고, 받은 뒤 번역합니다."
          }
        }
      }
    },
    "자동은 사용자 설정의 고정 모델을 건너뛰고 CLI 권장 모델을 사용합니다. 최신 Codex CLI를 사용하세요.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 사용자 설정의 고정 모델을 건너뛰고 CLI 권장 모델을 사용합니다. 최신 Codex CLI를 사용하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto skips the model pinned in your settings and uses the CLI's recommended model. Use the latest Codex CLI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」は設定で固定したモデルを使わず、CLI の推奨モデルを使います。最新の Codex CLI を使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”会跳过设置中固定的模型，改用 CLI 推荐的模型。请使用最新的 Codex CLI。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Auto » ignore le modèle fixé dans vos réglages et utilise le modèle recommandé par la CLI. Utilisez la dernière Codex CLI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Automatisch“ überspringt das in Ihren Einstellungen festgelegte Modell und verwendet das von der CLI empfohlene. Verwenden Sie die neueste Codex CLI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Auto» omite el modelo fijado en sus ajustes y usa el recomendado por la CLI. Use la última Codex CLI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Automático” ignora o modelo fixado nos seus ajustes e usa o modelo recomendado pela CLI. Use a Codex CLI mais recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Авто» пропускает модель, закреплённую в настройках, и использует модель, рекомендованную CLI. Используйте последнюю версию Codex CLI."
          }
        }
      }
    },
    "자동은 서버 목록의 첫 번째 모델을 사용합니다. 최신 출시 순서나 번역 품질 순위를 뜻하지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto uses the first model in the server list. It doesn't indicate the newest release or translation quality ranking."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」はサーバ一覧の最初のモデルを使用します。最新のリリース順や翻訳品質の順位を意味するものではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”使用服务器列表中的第一个模型，并不代表最新发布顺序或翻译质量排名。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto utilise le premier modèle de la liste du serveur. Cela n’indique ni le plus récent ni le meilleur en traduction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Automatisch“ verwendet das erste Modell der Serverliste. Dies bedeutet weder die neueste Version noch die beste Übersetzungsqualität."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático usa el primer modelo de la lista del servidor. No indica el más reciente ni el de mejor calidad de traducción."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático usa o primeiro modelo da lista do servidor. Isso não indica o lançamento mais recente nem a melhor qualidade de tradução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Авто» использует первую модель из списка сервера. Это не означает новейшую модель или лучшее качество перевода."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 서버 목록의 첫 번째 모델을 사용합니다. 최신 출시 순서나 번역 품질 순위를 뜻하지 않습니다."
          }
        }
      }
    },
    "자막 내용 없음 — 음성 또는 필터 설정을 확인해주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No subtitle content — check the audio or filter settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕の内容がありません — 音声またはフィルタ設定を確認してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无字幕内容 — 请检查音频或过滤设置"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun sous-titre — vérifiez l’audio ou les réglages de filtre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Untertitelinhalt — bitte Audio oder Filtereinstellungen prüfen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin contenido de subtítulos: revise el audio o los ajustes de filtro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma legenda gerada — verifique o áudio ou as configurações de filtro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Субтитры пусты — проверьте речь или настройки фильтра"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자막 내용 없음 — 음성 또는 필터 설정을 확인해주세요"
          }
        }
      }
    },
    "자막 내장 결과 검증 실패 — 원본 영상과 SRT 파일을 보존했습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to verify embedded subtitles — the original video and SRT file were kept"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕埋め込み結果の検証に失敗しました — 元の動画と SRT ファイルは保持しています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嵌入字幕结果验证失败 — 已保留原始视频和 SRT 文件"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la vérification de l’incrustation — la vidéo d’origine et le fichier SRT ont été conservés"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfung der eingebetteten Untertitel fehlgeschlagen — Originalvideo und SRT-Datei wurden beibehalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al verificar la incrustación de subtítulos: se conservaron el vídeo original y el archivo SRT"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na verificação das legendas incorporadas — o vídeo original e o arquivo SRT foram mantidos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить встроенные субтитры — исходное видео и файл SRT сохранены"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자막 내장 결과 검증 실패 — 원본 영상과 SRT 파일을 보존했습니다"
          }
        }
      }
    },
    "자막 내장 실패 — SRT 파일을 보존했습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to embed subtitles — the SRT file was kept"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕の埋め込みに失敗しました — SRT ファイルは保持しています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嵌入字幕失败 — 已保留 SRT 文件"
          }
