    "언어 및 지역 › 번역 언어에서 받은 언어를 확인하거나 삭제합니다. 다른 앱과 함께 쓰는 macOS 언어 팩입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View or delete downloaded languages in Language & Region › Translation Languages. These macOS language packs are shared with other apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語と地域 › 翻訳言語 で、ダウンロードした言語を確認または削除できます。他のアプリと共有される macOS の言語パックです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“语言与地区 › 翻译语言”中查看或删除已下载的语言。这些是与其他应用共用的 macOS 语言包。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez ou supprimez les langues téléchargées dans Langue et région › Langues de traduction. Ces packs de langue macOS sont partagés avec d’autres apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Sprache & Region › Übersetzungssprachen können Sie geladene Sprachen prüfen oder löschen. Es sind macOS-Sprachpakete, die auch von anderen Apps genutzt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte o elimine los idiomas descargados en Idioma y región › Idiomas de traducción. Son paquetes de idioma de macOS compartidos con otras apps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja ou remova os idiomas baixados em Idioma e Região › Idiomas de Tradução. São pacotes de idioma do macOS compartilhados com outros apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте или удалите загруженные языки в разделе Язык и регион › Языки перевода. Это языковые пакеты macOS, общие с другими приложениями."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 및 지역 › 번역 언어에서 받은 언어를 확인하거나 삭제합니다. 다른 앱과 함께 쓰는 macOS 언어 팩입니다."
          }
        }
      }
    },
