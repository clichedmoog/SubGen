    "언어를 확실하게 감지하지 못했습니다. 원본 언어를 지정해주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't detect the language reliably. Please specify the source language."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語を確実に検出できませんでした。元の言語を指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定检测到的语言。请指定原始语言。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue n’a pas pu être détectée avec certitude. Indiquez la langue d’origine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache konnte nicht sicher erkannt werden. Bitte geben Sie die Originalsprache an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo detectar el idioma con seguridad. Especifique el idioma original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível detectar o idioma com segurança. Especifique o idioma original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось надёжно определить язык. Укажите исходный язык."
          }
        },
        "ko": {
          "stringUnit": {
