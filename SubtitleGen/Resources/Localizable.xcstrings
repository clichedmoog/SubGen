          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open the installation file. Please download it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールファイルを開けませんでした。もう一度ダウンロードしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
