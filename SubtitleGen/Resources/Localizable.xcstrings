          }
        }
      }
    },
    "이 빌드에서는 번역을 아직 사용할 수 없습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation isn't available in this build yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドでは翻訳はまだ利用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本暂不支持翻译。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction n’est pas encore disponible dans cette version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzung ist in diesem Build noch nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción aún no está disponible en esta compilación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução ainda não está disponível nesta versão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод пока недоступен в этой сборке."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에서는 번역을 아직 사용할 수 없습니다."
          }
        }
      }
    },
    "이 앱의 번역 요청은 연결한 ChatGPT 플랜의 사용량 또는 크레딧을 사용합니다. ChatGPT 설정에서 사용량을 관리할 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation requests from this app use the usage or credits of your connected ChatGPT plan. You can manage usage in ChatGPT settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリの翻訳リクエストは、接続した ChatGPT プランの使用量またはクレジットを消費します。使用量は ChatGPT の設定で管理できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用的翻译请求会消耗所连接 ChatGPT 套餐的用量或额度。可在 ChatGPT 设置中管理用量。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les traductions de cette app utilisent l’utilisation ou les crédits du forfait ChatGPT connecté. Vous pouvez gérer votre utilisation dans les réglages de ChatGPT."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzungsanfragen dieser App nutzen das Kontingent oder die Credits Ihres verbundenen ChatGPT-Plans. Die Nutzung können Sie in den ChatGPT-Einstellungen verwalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes de traducción de esta app consumen el uso o los créditos del plan de ChatGPT conectado. Puede gestionar el uso en los ajustes de ChatGPT."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As traduções deste app consomem o uso ou os créditos do plano do ChatGPT conectado. Você pode gerenciar o uso nas configurações do ChatGPT."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы перевода расходуют лимит или кредиты подключённого плана ChatGPT. Управлять использованием можно в настройках ChatGPT."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 번역 요청은 연결한 ChatGPT 플랜의 사용량 또는 크레딧을 사용합니다. ChatGPT 설정에서 사용량을 관리할 수 있습니다."
          }
        }
      }
    },
    "이 영상 형식은 자막 내장을 지원하지 않습니다. 생성된 SRT 파일은 보존했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video format doesn't support embedded subtitles. The generated SRT file was kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この動画形式は字幕の埋め込みに対応していません。作成した SRT ファイルは保持しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此视频格式不支持嵌入字幕。已保留生成的 SRT 文件。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format vidéo ne prend pas en charge l’incrustation de sous-titres. Le fichier SRT créé a été conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Videoformat unterstützt keine eingebetteten Untertitel. Die erstellte SRT-Datei wurde beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato de vídeo no admite incrustar subtítulos. Se conservó el archivo SRT generado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato de vídeo não permite incorporar legendas. O arquivo SRT gerado foi mantido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот формат видео не поддерживает встраивание субтитров. Созданный файл SRT сохранён."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 영상 형식은 자막 내장을 지원하지 않습니다. 생성된 SRT 파일은 보존했습니다."
          }
        }
      }
    },
