    " 전사 SRT 원문을 %@에 보존했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " The original transcription SRT was kept at %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 文字起こしの SRT 原文を %@ に保存しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 已将转录的 SRT 原文保留在 %@。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " La transcription SRT d’origine a été conservée dans %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
